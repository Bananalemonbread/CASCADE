{
  "Extraction": { "name": "CSharpExtraction", "kwargs": { "framework": "net9.0" } },
  "CodeGenerator": { "name": "CSharpCodeGenerator", "kwargs": {
      "model": "llm3",
      "base_url": "https://llm3-compute.cms.hu-berlin.de/v1",
      "api_key": "ollama"
  } },
  "TestGenerator": { "name": "MultiStepCSharpTestGenerator", "kwargs": { 
      "model": "llm3",
      "base_url": "https://llm3-compute.cms.hu-berlin.de/v1",
      "api_key": "ollama"

   } },
  "Analysis": { "name": "CSharpTwoStepAnalysis", "kwargs": { "debug": 1, "regenerate": false } },
  "Executor": {
    "name": "CSharpExecutor",
    "kwargs": {
      "image": "mcr.microsoft.com/dotnet/sdk:9.0",
      "framework": "net9.0"
    }
  },
  "FilterFunctions": [
    { "name": "NoTestsFilterFunction", "kwargs": {} },
    { "name": "CheckLengthFilterFunction", "kwargs": { "key": "code", "op": ">", "val": 0 } },
    { "name": "CheckLengthFilterFunction", "kwargs": { "key": "doc", "op": ">", "val": 3 } }
  ]
}
